# Compiled files.
# dist/ is committed on purpose: the theme directory zip, GitHub installs and
# Playground all need the built CSS and there is no build step at install time.
# The empty *.js stubs wp-scripts writes beside CSS-only entries are noise.
/dist/css/*.js
.windsurfrules

