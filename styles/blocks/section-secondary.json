{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "title": "Secondary band",
  "slug": "section-secondary",
  "blockTypes": ["core/group", "core/columns", "core/column"],
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--secondary)",
      "text": "var(--wp--preset--color--base)"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--base)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--base)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--base)"
          },
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--base)",
          "text": "var(--wp--preset--color--secondary)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--contrast-light)",
            "text": "var(--wp--preset--color--secondary)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--contrast-light)",
            "text": "var(--wp--preset--color--secondary)"
          },
          "outline": {
            "color": "var(--wp--preset--color--base)"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--contrast-light)"
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--base)"
        },
        "css": "opacity: 0.25;"
      },
      "core/post-date": {
        "color": {
          "text": "var(--wp--preset--color--contrast-light)"
        }
      }
    }
  }
}
